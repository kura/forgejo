[Unit]
Description=Forgejo container

[Container]
Pod=forgejo.pod
ContainerName=forgejo
Image=git.kura.gg/kura/forgejo/forgejo:latest
AutoUpdate=registry

Volume=/data/forgejo:/data

Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=TZ=Etc/UTC

HealthCmd="curl --fail http://localhost:3000/api/healthz || exit 1"
HealthInterval=60s
HealthRetries=5
HealthTimeout=10s
HealthStartPeriod=10s
HealthOnFailure=kill

[Service]
Restart=always

[Install]
WantedBy=default.target
