#!/usr/bin/bash
set -euo pipefail
if ! command -v jq > /dev/null || ! command -v curl > /dev/null; then echo "Please install curl and jq" && exit 1; fi
if [ "$#" -ne 1 ]; then echo "Containerfile param required" && exit 1; fi
CONTAINERFILE=$1

gh_api() {
    curl -fsSL --retry 3 \
         -H "Accept: application/vnd.github+json" \
         ${GH_API_TOKEN:+-H "Authorization: Bearer $GH_API_TOKEN"} \
         "https://api.github.com/repos/$1"
}

openssl=$(gh_api openssl/openssl/releases | \
        jq -r '.[].tag_name' | \
        grep -vE "alpha|beta" | \
        cut -d'v' -f 2 |  \
        tr -d '[:alpha:][=-=]' | \
        sed -n 1p)

nginx=$(gh_api nginx/nginx/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]')

luajit=$(gh_api openresty/luajit2/releases | \
         jq -r '.[0].tag_name' | \
         cut -d'v' -f 2 | \
         tr -d '[:alpha:]')

acme=$(gh_api nginx/nginx-acme/releases | \
       jq -r '.[0].tag_name' | \
       cut -d'v' -f 2 | \
       tr -d '[:alpha:][=-=]')

naxsi=$(gh_api wargio/naxsi/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]')

ndk=$(gh_api vision5/ngx_devel_kit/releases | \
      jq -r '.[0].tag_name' | \
      cut -d'v' -f 2 | \
      tr -d '[:alpha:][=-=]')

vts=$(gh_api vozlt/nginx-module-vts/releases | \
      jq -r '.[0].tag_name' | \
      cut -d'v' -f 2 | \
      tr -d '[:alpha:][=-=]')

resty_core=$(gh_api openresty/lua-resty-core/tags | \
             jq -r '.[].name' | \
             grep -vi r | \
             cut -d'v' -f 2 | \
             tr -d '[:alpha:][=-=]' | \
             sed -n 1p)

lua=$(curl -sfL "https://raw.githubusercontent.com/openresty/lua-resty-core/v${resty_core}/lib/resty/core/base.lua" | \
      grep -oE 'ngx_http_lua_module [0-9]+\.[0-9]+\.[0-9]+' | \
      awk 'NR==1 {print $2}')

if [ -z "$lua" ]; then
    echo "could not determine ngx_lua version required by lua-resty-core ${resty_core}" && exit 1
fi

resty_lru=$(gh_api openresty/lua-resty-lrucache/tags | \
            jq -r '.[].name' | \
            grep -vi r | \
            cut -d'v' -f 2 | \
            tr -d '[:alpha:][=-=]' | \
            sed -n 1p)

echo "openssl=$openssl"
echo "nginx=$nginx"
echo "nginx-acme=$acme"
echo "naxsi=$naxsi"
echo "nginx-devel-kit=$ndk"
echo "luajit=$luajit"
echo "nginx-vts=$vts"
echo "resty_core=$resty_core"
echo "resty_lru=$resty_lru"

sed -i \
    -re "s/(ENV OPENSSL_VERSION)=.*/\1=$openssl/g" \
    -re "s/(ENV NGINX_VERSION)=.*/\1=$nginx/g" \
    -re "s/(ENV ACME_VERSION)=.*/\1=$acme/g" \
    -re "s/(ENV LUAJIT_VERSION)=.*/\1=$luajit/g" \
    -re "s/(ENV NAXSI_VERSION)=.*/\1=$naxsi/g" \
    -re "s/(ENV NDK_VERSION)=.*/\1=$ndk/g" \
    -re "s/(ENV NGX_LUA_VERSION)=.*/\1=$lua/g" \
    -re "s/(ENV NGX_VTS_VERSION)=.*/\1=$vts/g" \
    -re "s/(ENV LUA_RESTY_CORE_VERSION)=.*/\1=$resty_core/g" \
    -re "s/(ENV LUA_RESTY_LRU_VERSION)=.*/\1=$resty_lru/g" \
    "$CONTAINERFILE"
