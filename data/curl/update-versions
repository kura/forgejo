#!/usr/bin/bash
set -euo pipefail
if ! command -v jq > /dev/null || ! command -v curl > /dev/null; then echo "Please install curl and jq" && exit 1; fi
if [ "$#" -ne 1 ]; then echo "Containerfile param required" && exit 1; fi
CONTAINERFILE=$1

gh_api() {
    curl -fsSL --retry 3 \
         -H "Accept: application/vnd.github+json" \
         ${GH_API_TOKEN:+-H "Authorization: Bearer $GH_API_TOKEN"} \
         "https://api.github.com/repos/$1"
}

openssl=$(gh_api openssl/openssl/releases 2>&1 /dev/null | \
        jq -r '.[].tag_name' | \
        grep -vE "alpha|beta" | \
        cut -d'v' -f 2 |  \
        tr -d '[:alpha:][=-=]' | \
        head -1)

curl=$(gh_api curl/curl/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]' |
        sed 's/_/\./g')

nghttp2=$(gh_api nghttp2/nghttp2/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]')

nghttp3=$(gh_api ngtcp2/nghttp3/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]')

ngtcp2=$(gh_api ngtcp2/ngtcp2/releases | \
        jq -r '.[0].tag_name' | \
        cut -d'v' -f 2 | \
        tr -d '[:alpha:][=-=]')

echo "openssl=$openssl"
echo "curl=$curl"
echo "nghttp2=$nghttp2"
echo "nghttp3=$nghttp3"
echo "ngtcp2=$ngtcp2"

sed -i \
    -re "s/(ENV OPENSSL_VERSION).*/\1=$openssl/g" \
    -re "s/(ENV CURL_VERSION).*/\1=$curl/g" \
    -re "s/(ENV NGTCP2_VERSION).*/\1=$ngtcp2/g" \
    -re "s/(ENV NGHTTP2_VERSION).*/\1=$nghttp2/g" \
    -re "s/(ENV NGHTTP3_VERSION).*/\1=$nghttp3/g" \
    "$CONTAINERFILE"
